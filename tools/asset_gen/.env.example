# gpt-image-2 via 4sapi (OpenAI-compatible)
FOURSAPI_API_KEY=sk-your-key
# Prefer .org — .com may hit SSL hostname mismatch locally
FOURSAPI_BASE_URL=https://4sapi.org

# Seedance video (Volcengine Ark) — SoulNexus pkg/mediagen compatible
# SEEDREAM_API_KEY=          # Ark Bearer (or SEEDANCE_API_KEY=)
# SEEDANCE_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# SEEDANCE_MODEL_ID=doubao-seedance-1-5-pro-251215
# SEEDANCE_GENERATE_AUDIO=false
# MEDIAGEN_VIDEO_POLL_INTERVAL_MS=10000
# MEDIAGEN_VIDEO_POLL_MAX_ATTEMPTS=120

# Optional other backends
# GOOGLE_API_KEY=
# XAI_API_KEY=
# TRIPO3D_API_KEY=
